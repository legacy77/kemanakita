# Supabase — salin ke .env.local (jangan commit .env.local)
# Sumber: Supabase Dashboard → Project Settings → API

# Client-safe (dipakai di browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — opsional; kosong berarti error tracking nonaktif tanpa mengganggu aplikasi
NEXT_PUBLIC_SENTRY_DSN=
# Opsional: label release; Vercel memakai VERCEL_GIT_COMMIT_SHA otomatis bila tersedia
NEXT_PUBLIC_SENTRY_RELEASE=

# Server-only — JANGAN pakai prefix NEXT_PUBLIC_
SUPABASE_SERVICE_KEY=
